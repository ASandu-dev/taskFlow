generator client {
  provider      = "prisma-client"
  output        = "../src/.prisma-client-v2"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id        String   @id @default(cuid())
  title     String
  projectId String
  priority  Priority
  status    TaskStatus
  time      String?
  date      String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([date])
  @@index([status])
}

model Project {
  id    String   @id @default(cuid())
  name  String
  color String
  tasks Task[]
}

model Goal {
  id       String @id @default(cuid())
  title    String
  progress Int
  target   Int
  color    String
}

model CalendarEvent {
  id    String @id @default(cuid())
  title String
  date  String
  time  String
  color String
}

model User {
  id          String @id @default(cuid())
  name        String
  plan        String
  avatarColor String
  initials    String
}

enum Priority {
  low
  medium
  high
}

enum TaskStatus {
  todo
  done
}
