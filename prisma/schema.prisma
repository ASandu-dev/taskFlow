generator client {
  provider      = "prisma-client"
  output        = "../src/.prisma-client-v2"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id        String   @id @default(cuid())
  title     String
  projectId String
  priority  Priority
  status    TaskStatus
  time      String?
  date      String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([date])
  @@index([status])
}

model Project {
  id    String   @id @default(cuid())
  name  String
  color String
  tasks Task[]
}

model Goal {
  id       String @id @default(cuid())
  title    String
  progress Int
  target   Int
  color    String
}

model CalendarEvent {
  id            String        @id @default(cuid())
  title         String
  date          String
  time          String
  color         String
  category      String?
  source        String        @default("local")
  externalId    String?       @unique
  familyGroupId String?
  familyGroup   FamilyGroup?  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)

  @@index([source])
  @@index([familyGroupId])
}

model FamilyGroup {
  id          String               @id @default(cuid())
  name        String
  description String?
  inviteCode  String               @unique
  adminId     String // Clerk user id of the group creator (admin)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     FamilyGroupMember[]
  events      CalendarEvent[]

  @@index([adminId])
}

model FamilyGroupMember {
  id       String      @id @default(cuid())
  groupId  String
  userId   String // Clerk user id
  joinedAt DateTime    @default(now())
  group    FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Integration {
  id            String    @id @default(cuid())
  provider      String    @unique
  connected     Boolean   @default(false)
  accessToken   String?
  refreshToken  String?
  tokenType     String?
  scope         String?
  expiresAt     DateTime?
  accountEmail  String?
  calendarId    String    @default("primary")
  lastSyncedAt  DateTime?
  lastSyncError String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model User {
  id          String @id @default(cuid())
  name        String
  plan        String
  avatarColor String
  initials    String
}

enum Priority {
  low
  medium
  high
}

enum TaskStatus {
  todo
  done
}
